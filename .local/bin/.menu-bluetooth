#!/usr/bin/env bash
# vi: ft=bash

runtime=${XDG_RUNTIME_DIR:-/tmp}
double_click_ms=400
# How long the "new devices" picker shows "Scanning…" before listing. Discovery
# has no completion signal to wait on, so the window is fixed.
scan_s=8
# Upper bound on the background scanner's life. It is killed on exit; this only
# stops a SIGKILLed run from leaving discovery on for good.
scan_session_s=120
# How long bluetoothctl stays registered as the pairing agent, and how many
# polls the bond is given inside that.
pair_agent_s=20
bond_tries=60
call_timeout_s=30
# wait_dev / wait_adapter: how often and how long a property is re-read.
poll_tries=15
poll_s=0.2

notify() {
    # swaync renders body markup, and a device name can contain & < >. The
    # quoted replacements keep bash's patsub_replacement from reading & as the
    # match.
    local body=${1//'&'/'&amp;'}
    body=${body//'<'/'&lt;'}
    body=${body//'>'/'&gt;'}
    command -v notify-send >/dev/null && notify-send -- "Bluetooth" "$body"
}

# A connect takes seconds and a pair longer. Where pikr can hold its window
# open on a loading line the wait happens there, in the picker itself; this is
# the fallback for a pikr that cannot, and -e is in stock pikr. Either way
# something stays on screen: a notification alone is easy to miss, and an empty
# screen reads as nothing happened.
busy() {
    # 9>&-: the modal must not inherit the lock, or a run killed while it is up
    # leaves the lock held until the modal is dismissed.
    pikr -e "$1" 9>&- >/dev/null 2>&1 &
    busy_pid=$!
}
busy_done() {
    [[ -n $busy_pid ]] && kill "$busy_pid" 2>/dev/null
    busy_pid=''
}

# The reason from busctl's output ($1) for a notification.
bt_error() {
    local error
    error=$(grep -m 1 . <<<"$1")
    error=${error#Call failed: }
    error=${error#Failed to set property: }
    printf '%s' "${error:-no reason given}"
}

# Milliseconds since boot. Unlike the wall clock it never steps backwards,
# which would leave a stamp in the future and the menu refusing to open.
uptime_ms() {
    awk '{ printf "%d", $1 * 1000 }' /proc/uptime
}

# A press within double_click_ms of the picker being launched is the second
# half of a double-click — ignore it. Checked before the toggle so it also
# covers the moment before pikr's window exists.
stamp="$runtime/menu-bluetooth.opened"
opened=$(cat "$stamp" 2>/dev/null)
[[ $opened =~ ^[0-9]+$ ]] || opened=0
elapsed=$(($(uptime_ms) - opened))
((elapsed >= 0 && elapsed < double_click_ms)) && exit 0

# Toggle: a later press while one of this menu's pickers is open closes it.
# Matched on pikr's arguments so other pikr menus are left alone; every prompt
# this menu uses starts with "Bluetooth".
menu_pikr='^pikr -d -p Bluetooth'
if pgrep -f "$menu_pikr" >/dev/null; then
    pkill -f "$menu_pikr"
    exit 0
fi

# Serialise runs. The lock is held while the run starts up and again from each
# pick until the next picker opens or the run ends, so a click in either window
# bails instead of starting a second menu. It is released while a picker is
# open, where the toggle above handles clicks.
exec 9>"$runtime/menu-bluetooth.lock"
flock -n 9 || exit 0

# Everything bluetoothd knows, as one JSON document: the adapter and every
# device object with its properties. Reads go through this rather than
# bluetoothctl's text, which has no stable format.
snapshot() {
    objects=$(busctl --json=short call org.bluez / org.freedesktop.DBus.ObjectManager GetManagedObjects 2>/dev/null)
}

# A property of the adapter ($1) or of a device ($1 path, $2 property) from a
# fresh snapshot: "true", "false", a value, or empty when it isn't there.
# Spelled with an explicit null test because jq's // treats false as missing.
adapter_prop() {
    snapshot && jq -r --arg p "$adapter" --arg k "$1" \
        '.data[0][$p]["org.bluez.Adapter1"][$k].data | if . == null then "" else tostring end' <<<"$objects"
}
dev_prop() {
    snapshot && jq -r --arg p "$1" --arg k "$2" \
        '.data[0][$p]["org.bluez.Device1"][$k].data | if . == null then "" else tostring end' <<<"$objects"
}
dev_exists() {
    snapshot && jq -e --arg p "$1" '.data[0] | has($p)' <<<"$objects" >/dev/null
}

# The property is the truth, not the exit status of the call that was meant to
# change it: "already connected" and "in progress" are errors whose outcome is
# fine, and an adapter passes through a transitional state on its way up.
wait_dev() {
    for _ in $(seq 1 "${4:-$poll_tries}"); do
        [[ $(dev_prop "$1" "$2") == "$3" ]] && return 0
        sleep "$poll_s"
    done
    return 1
}

# bluetoothctl says this once bluez has accepted its agent as the default one,
# which is the moment bluez adopts that agent's IO capability. Pairing before
# it goes out under whatever capability was default before — see do_pair.
wait_agent() {
    for _ in $(seq 1 "$poll_tries"); do
        grep -qF 'Default agent request successful' "$pairlog" && return 0
        sleep "$poll_s"
    done
    return 1
}
wait_adapter() {
    for _ in $(seq 1 "$poll_tries"); do
        [[ $(adapter_prop "$1") == "$2" ]] && return 0
        sleep "$poll_s"
    done
    return 1
}

if ! snapshot; then
    notify "Bluetooth service isn't running"
    exit
fi
# The first adapter; a second one is not offered (see docs/backlog.md).
adapter=$(jq -r '[.data[0] | to_entries[] | select(.value["org.bluez.Adapter1"]) | .key] | sort | .[0] // empty' <<<"$objects")
if [[ -z $adapter ]]; then
    notify "No Bluetooth adapter"
    exit
fi

# Rows for the picker. The id of each row goes to $ids on the same line number
# as its row in $rows, so the pick maps back to a device without parsing the
# display text. An id is "action<US>path<US>alias": the action is the one the
# row offered, so a device that reconnected on its own while the list was up
# isn't disconnected by an Enter that meant "connect".
scanner='' busy_pid='' pair_pid=''
ids='' rows='' pairlog='' agentdir=''
cleanup() {
    [[ -n $scanner ]] && kill "$scanner" 2>/dev/null
    [[ -n $busy_pid ]] && kill "$busy_pid" 2>/dev/null
    [[ -n $pair_pid ]] && kill "$pair_pid" 2>/dev/null
    rm -f -- "$ids" "$rows" "$pairlog"
    if [[ -n $agentdir ]]; then
        rm -f -- "$agentdir/ctl"
        rmdir -- "$agentdir"
    fi
}
trap cleanup EXIT
ids=$(mktemp "$runtime/menu-bluetooth.ids.XXXXXX") || exit
rows=$(mktemp "$runtime/menu-bluetooth.rows.XXXXXX") || exit
pairlog=$(mktemp "$runtime/menu-bluetooth.pair.XXXXXX") || exit
# A named pipe, not a coprocess: bluetoothctl has to stay readable on stdin for
# its whole life, and the pairing command can only be written once bluez has
# taken the agent — see do_pair.
agentdir=$(mktemp -d "$runtime/menu-bluetooth.agent.XXXXXX") || exit
mkfifo "$agentdir/ctl" || exit

# jq does the shaping — filter, sort, glyphs, the suffix that tells two devices
# with one name apart — because splitting tab-separated fields in bash drops
# the empty ones. Glyphs are \u escapes (Nerd Font, private use) since they are
# invisible in most editors. Tabs and newlines in a name would break the
# columns, and the unit separator would break the id.
device_rows() {
    jq -r --arg mode "$1" --arg adapter "$adapter" '
def glyph:
    if . == null then "\uf294"
    elif startswith("audio") then "\uf025"
    elif . == "input-keyboard" then "\uf11c"
    elif . == "input-mouse" then "\uf245"
    elif . == "input-gaming" then "\uf11b"
    elif . == "phone" then "\uf10b"
    elif . == "computer" then "\uf109"
    else "\uf294" end;
def bars:
    if . >= -60 then "████" elif . >= -70 then "███" elif . >= -80 then "██" else "█" end;
[ .data[0] | to_entries[]
  | select(.value["org.bluez.Device1"])
  | .value["org.bluez.Device1"] as $d
  | select($d.Adapter.data == $adapter)
  | { path: .key,
      mac: $d.Address.data,
      alias: (($d.Alias.data // $d.Address.data) | gsub("[\\t\\n\\r\u001f]"; " ")),
      named: ($d.Name.data != null),
      paired: ($d.Paired.data == true),
      connected: ($d.Connected.data == true),
      blocked: ($d.Blocked.data == true),
      rssi: $d.RSSI.data,
      icon: $d.Icon.data,
      battery: .value["org.bluez.Battery1"].Percentage.data } ] as $all
| ( if $mode == "scan" then
        [ $all[] | select((.paired | not) and (.blocked | not) and .rssi != null and .named) ] | sort_by(-.rssi)
    elif $mode == "forget" then
        [ $all[] | select(.paired) ] | sort_by(.alias | ascii_downcase)
    else
        [ $all[] | select(.paired or .connected) ] | sort_by([(.connected | not), (.alias | ascii_downcase)])
    end ) as $list
| ( $list | map(.alias) | group_by(.) | map(select(length > 1) | .[0]) ) as $dups
| $list[]
| (.alias as $a | if ($dups | index($a)) != null then "\($a) [\(.mac[-5:])]" else $a end) as $shown
| ( if $mode == "forget" then "forget"
    elif .blocked then "blocked"
    elif (.paired | not) then "pair"
    elif .connected then "disconnect"
    else "connect" end ) as $action
| ( if .connected then "●" elif .blocked then "\uf05e" elif .paired then "○" else "\uf067" end ) as $dot
| ( if .blocked then "Blocked"
    elif (.paired | not) and .connected then "Connected · not paired"
    elif .connected then "Connected" + (if .battery != null then " · \(.battery)%" else "" end)
    elif .paired then "Paired"
    else "New · " + (.rssi | bars) end ) as $state
| [ ([$action, .path, .alias] | join("\u001f")),
    ($dot + "  " + (.icon | glyph) + "  " + $shown),
    $state ] | join("\t")
' <<<"$objects"
}

# Nerd Font glyphs for the action rows, as UTF-8 bytes (private-use glyphs are
# invisible in most editors): plus, trash, power, search. Dingbats such as the
# return symbol or a ballot X are not in Hack Nerd Font, so rows stick to what
# the font has.
glyph_pair=$'\xef\x81\xa7'
glyph_forget=$'\xef\x87\xb8'
glyph_power=$'\xef\x80\x91'
glyph_scan=$'\xef\x80\x82'

glyph_more=$'\xef\x85\x81'

any_paired() {
    jq -e --arg adapter "$adapter" \
        '[.data[0][] | .["org.bluez.Device1"] | select(. != null and .Adapter.data == $adapter and .Paired.data == true)] | length > 0' \
        <<<"$objects" >/dev/null
}

# $1 is the list to build. known, scan and forget hold devices and nothing
# else, the way bluetui's tables do: the actions are keys, named in the prompt.
# A pikr without --kb-custom has no keys to name, so there the device lists
# carry one row through to a list of the actions instead. Where the keys are
# bound a mouse reaches connect and disconnect and nothing else, which is a
# deliberate trade and written up in the backlog. off is the adapter powered
# down. A list that would come out empty gets one row saying why, with the way
# out.
build_list() {
    local table
    table=$(
        case $1 in
        off) printf '%s\t%s  %s\n' "@power-on" "$glyph_power" "Bluetooth is off — turn on" ;;
        actions)
            printf '%s\t%s  %s\n' "@scan" "$glyph_pair" "Pair a new device…"
            any_paired && printf '%s\t%s  %s\n' "@forget" "$glyph_forget" "Forget a device…"
            printf '%s\t%s  %s\n' "@power-off" "$glyph_power" "Turn Bluetooth off"
            ;;
        *) device_rows "$1" ;;
        esac
    )
    if [[ -z $table ]]; then
        case $1 in
        scan) table=$(printf '%s\t%s  %s' "@scan" "$glyph_scan" "Nothing found — scan again…") ;;
        *) table=$(printf '%s\t%s  %s' "@scan" "$glyph_pair" "No paired devices — pair one…") ;;
        esac
    fi
    # Without keys the device lists need one way through to the actions.
    if ! $has_keys && [[ $1 == known || $1 == scan ]]; then
        table+=$'\n'$(printf '%s\t%s  %s' "@actions" "$glyph_more" "More actions…")
    fi
    # The ids are on disk before the first row reaches pikr: written from a
    # process substitution they could still be in flight when a pick lands.
    cut -f1 <<<"$table" >"$ids"
    cut -f2- <<<"$table" | column -t -s $'\t' | sed 's/[[:space:]]*$//' | tee "$rows"
}

pikr_help=$(pikr --help 2>/dev/null)

# Actions are keys, as in bluetui, with its letters where pikr leaves them free
# (s scan, o power; its u for unpair is pikr's clear-line, so forget is Right,
# as in the Wi-Fi menu). They need a pikr with --kb-custom KEY=PROMPT, which
# stock pikr lacks, so detect instead of assuming. pikr numbers the bindings'
# exit statuses from key_first in the order they are given.
key_first=10
key_forget=$key_first key_scan=$((key_first + 1)) key_power=$((key_first + 2))
key_rescan=$key_first
has_keys=false
known_keys=() known_legend=""
scan_keys=() scan_legend=""
if grep -qF 'KEY[=PROMPT]' <<<"$pikr_help"; then
    has_keys=true
    known_keys=(--kb-custom 'Right=Forget?' --kb-custom 'Ctrl+s' --kb-custom 'Ctrl+o=Turn Bluetooth off?')
    known_legend="  (→ forget · ^S scan · ^O off)"
    scan_keys=(--kb-custom 'Ctrl+s')
    scan_legend="  (^S rescan)"
fi
loading=()
grep -qF -- '--loading' <<<"$pikr_help" && loading=(--loading "Scanning…")

# Discovery belongs to the D-Bus client that asked for it and ends with it, so
# it needs a process that stays: a busctl call would stop scanning as it
# returned. Left running through a pair, because an unpaired device's object
# expires shortly after discovery stops.
start_scan() {
    [[ -n $scanner ]] && kill -0 "$scanner" 2>/dev/null && return 0
    # 9>&-: the scanner must not inherit the lock, or a run killed while it is
    # up leaves the lock held until the scanner times out.
    bluetoothctl --timeout "$scan_session_s" scan on >/dev/null 2>&1 9>&- &
    scanner=$!
    # --timeout hides the exit status, so ask the adapter whether it started.
    wait_adapter Discovering true
}

# Hand a device the picker can't pair to bluetui, which can show a passkey and
# take a PIN. Backgrounded rather than exec'd so the EXIT trap still runs.
hand_off() {
    [[ -n $pair_pid ]] && kill "$pair_pid" 2>/dev/null
    [[ -n $scanner ]] && kill "$scanner" 2>/dev/null
    notify "$1 needs bluetooth pairing this menu can't do; opening bluetui"
    alacritty --class floating -e bluetui >/dev/null 2>&1 9>&- &
    exit
}

do_connect() {
    local path=$1 alias=$2 out reason
    if [[ $(dev_prop "$path" Connected) == true ]]; then
        notify "Connected to $alias"
        return
    fi
    out=$(busctl --timeout="$call_timeout_s" call org.bluez "$path" org.bluez.Device1 Connect 2>&1)
    if wait_dev "$path" Connected true; then
        notify "Connected to $alias"
        return
    fi
    reason=$(bt_error "$out")
    if [[ $reason == *page-timeout* || $reason == *"Host is down"* ]]; then
        notify "$alias isn't responding; is it on and in range?"
    else
        notify "Could not connect to $alias: $reason"
    fi
}

do_disconnect() {
    local path=$1 alias=$2 out
    out=$(busctl --timeout="$call_timeout_s" call org.bluez "$path" org.bluez.Device1 Disconnect 2>&1)
    if wait_dev "$path" Connected false; then
        notify "Disconnected $alias"
    else
        notify "Could not disconnect $alias: $(bt_error "$out")"
    fi
}

do_forget() {
    local path=$1 alias=$2 out
    if [[ $(dev_prop "$path" Paired) != true ]]; then
        notify "$alias isn't paired"
        return
    fi
    out=$(busctl --timeout="$call_timeout_s" call org.bluez "$adapter" org.bluez.Adapter1 RemoveDevice o "$path" 2>&1)
    if dev_exists "$path"; then
        notify "Could not forget $alias: $(bt_error "$out")"
    else
        notify "Forgot $alias"
    fi
}

# Whether a failed pair ($1, bluetoothctl's output) is one bluetui could still
# manage. Two shapes, both ending in the same hand-off:
#
#   - a passkey or PIN was wanted: an authentication error, or a prompt this
#     agent could not answer;
#   - the pairing succeeded and was then rolled back. Observed with AirPods
#     Pro: "Pairing successful", then bluez terminating the link locally and
#     Paired going back to no, with Bonded never set — no key was stored.
#     bluetui pairs the same earbuds, so what a script can drive through
#     bluetoothctl is the limit here, not the hardware.
pair_needs_bluetui() {
    grep -qE 'Authentication ?(Failed|Rejected|Canceled|Timeout)|Enter PIN code|Enter passkey|Confirm passkey|PIN code:|Passkey:' <<<"$1" && return 0
    grep -qF 'Pairing successful' <<<"$1"
}

do_pair() {
    local path=$1 alias=$2 mac out reason
    if ! dev_exists "$path"; then
        notify "$alias is no longer visible; scan again"
        return
    fi
    # bluetoothctl's pair removes an existing pairing before it starts, so a
    # device that is already paired must never reach it.
    if [[ $(dev_prop "$path" Paired) == true ]]; then
        do_connect "$path" "$alias"
        return
    fi
    [[ $(dev_prop "$path" LegacyPairing) == true ]] && hand_off "$alias"
    mac=$(dev_prop "$path" Address)
    # Stop discovering first. The radio cannot inquire and pair at once without
    # the pairing suffering for it: with the scanner left running, AirPods Pro
    # reported Paired: yes and never Bonded, while bluetui — which is not
    # scanning by the time you pick a device — bonds them. The device object
    # outlives discovery long enough to pair (TemporaryTimeout, 30s by default
    # in main.conf), which is why it can be stopped here rather than after.
    if [[ -n $scanner ]]; then
        kill "$scanner" 2>/dev/null
        scanner=''
        wait_adapter Discovering false
    fi
    # Connected without being paired means the device opened the link itself,
    # on a key only it still holds: forgetting here deletes the adapter's copy
    # and nothing tells the device to drop its own. Pairing on top of a link
    # somebody else authenticated is not the exchange this wants, so take the
    # link down and let the pairing below be the one that brings it up.
    if [[ $(dev_prop "$path" Connected) == true ]]; then
        busctl --timeout="$call_timeout_s" call org.bluez "$path" \
            org.bluez.Device1 Disconnect >/dev/null 2>&1
        wait_dev "$path" Connected false
    fi
    # bluetoothctl rather than Device1.Pair: pairing needs an agent, and this
    # registers its own instead of depending on one happening to be running.
    # KeyboardDisplay is the capability bluetui's agent has.
    #
    # Driven over a coprocess rather than handed `pair` as an argument. bluez
    # takes the IO capability from the default agent at the moment it is asked
    # to pair, and the argument form asks before its own agent is registered —
    # --agent never reaches bluez at all. Traced on AirPods Pro: that pairing
    # went out as Capability: NoInputNoOutput, which negotiates No Bonding, and
    # a No Bonding key is deliberately never stored, so Paired went yes and
    # straight back to no. The same earbuds on bluetui, whose agent is already
    # registered, pair as KeyboardDisplay and keep the key. So wait for bluez
    # to accept the agent before asking, and hold the process open across the
    # bond, because an agent lives only as long as it does.
    timeout "$pair_agent_s" bluetoothctl --agent KeyboardDisplay \
        <"$agentdir/ctl" >"$pairlog" 2>&1 &
    pair_pid=$!
    # Opened read-write so the open returns whether or not the reader is up
    # yet; a write-only open on a pipe blocks until one is.
    exec {ctl}<>"$agentdir/ctl"
    printf 'default-agent\n' >&"$ctl"
    if ! wait_agent; then
        kill "$pair_pid" 2>/dev/null
        pair_pid=''
        exec {ctl}>&-
        notify "Could not register a pairing agent for $alias"
        return
    fi
    printf 'pair %s\n' "$mac" >&"$ctl"
    wait_dev "$path" Bonded true "$bond_tries"
    kill "$pair_pid" 2>/dev/null
    pair_pid=''
    exec {ctl}>&-
    out=$(cat "$pairlog")
    # Paired without Bonded means no key was stored: the pairing dies with the
    # connection and the device will not come back by itself. A bluetoothd too
    # old to have Bonded reports nothing, which stays a pass.
    if [[ $(dev_prop "$path" Paired) == true && $(dev_prop "$path" Bonded) == false ]]; then
        busctl call org.bluez "$adapter" org.bluez.Adapter1 RemoveDevice o "$path" >/dev/null 2>&1
        [[ -n $scanner ]] && kill "$scanner" 2>/dev/null
        notify "$alias paired but stored no key; opening bluetui to pair it"
        alacritty --class floating -e bluetui >/dev/null 2>&1 9>&- &
        exit
    fi
    if [[ $(dev_prop "$path" Paired) != true ]]; then
        pair_needs_bluetui "$out" && hand_off "$alias"
        reason=$(grep -oE 'org\.bluez\.Error\.[A-Za-z.]+' <<<"$out" | head -n 1)
        reason=${reason#org.bluez.Error.}
        notify "Could not pair with $alias: ${reason:-no response}"
        return
    fi
    # Trusted lets the device reconnect by itself later, when no agent is
    # around to authorise it.
    busctl set-property org.bluez "$path" org.bluez.Device1 Trusted b true >/dev/null 2>&1
    if ! wait_dev "$path" Connected true; then
        out=$(busctl --timeout="$call_timeout_s" call org.bluez "$path" org.bluez.Device1 Connect 2>&1)
        if ! wait_dev "$path" Connected true; then
                notify "Paired with $alias, but could not connect: $(bt_error "$out")"
            return
        fi
    fi
    notify "Paired and connected to $alias"
}

# $1 is on or off; returns whether the adapter got there.
do_power() {
    local want=true out
    [[ $1 == off ]] && want=false
    out=$(busctl set-property org.bluez "$adapter" org.bluez.Adapter1 Powered b "$want" 2>&1)
    wait_adapter Powered "$want" && return 0
    notify "Could not turn Bluetooth $1: $(bt_error "$out")"
    return 1
}

# The adapter state for the prompt: how many devices are connected, if any.
connected_note() {
    local n
    n=$(jq -r --arg adapter "$adapter" \
        '[.data[0][] | .["org.bluez.Device1"] | select(. != null and .Adapter.data == $adapter and .Connected.data == true)] | length' \
        <<<"$objects")
    ((n > 0)) && printf ' · %s connected' "$n"
}

# Open a picker over list $1 with prompt $2 (further arguments go to pikr),
# leaving the row in $pick and returning pikr's exit status.
pick_from() {
    local list=$1 title=$2
    shift 2
    pick=$(build_list "$list" | pikr -d -p "$title" "$@")
}

# Back under the lock for the rest of the run, so a click while connecting
# doesn't open a second menu that acts on the same device.
relock() {
    flock -w 5 9 && return 0
    notify "Another Bluetooth menu is starting; pick again"
    return 1
}

pending=() busy_text='' mode=known

while :; do
    if ! snapshot; then
        notify "Bluetooth service isn't running"
        exit
    fi
    [[ $(adapter_prop Powered) == true ]] || mode=off

    scanning=()
    if [[ $mode == scan ]]; then
        if ! start_scan; then
            notify "Could not start a Bluetooth scan"
            exit
        fi
        if ((${#loading[@]})); then
            scanning=("${loading[@]}")
        else
            # Stock pikr: a modal for the window, under the lock as the
            # startup is. 9>&- for the same reason as the scanner.
            pikr -e "Bluetooth: scanning…" 9>&- &
            modal=$!
            sleep "$scan_s"
            kill "$modal" 2>/dev/null
            snapshot
        fi
    fi

    known_prompt="Bluetooth$(connected_note)$known_legend"

    # Stamp the launch for the double-click guard, then release the lock so a
    # later press reaches the toggle.
    uptime_ms >"$stamp"
    flock -u 9

    # A slow action runs in the producer of the next picker: the window opens
    # at once on its loading line, and the rows that replace it are the list
    # rebuilt afterwards, so the device is shown in its new state. The lock
    # stays released for it, as it does whenever a window is up — a click
    # reaches the toggle, which closes the window while the action finishes on
    # its own.
    if ((${#pending[@]})); then
        if ((${#loading[@]})); then
            pick=$({ "${pending[@]}" >/dev/null; snapshot; build_list known; } | pikr -d -p "$known_prompt" --loading "$busy_text" "${known_keys[@]}")
            picked=$?
        else
            busy "$busy_text"
            "${pending[@]}" >/dev/null
            busy_done
                pending=()
            continue
        fi
        pending=()
        mode=known
    else
    case $mode in
    scan)
        if ((${#scanning[@]})); then
            # Open the picker now with "Scanning…" where the list goes; the
            # rows replace it when build_list closes pikr's stdin.
            pick=$({ sleep "$scan_s"; snapshot; build_list scan; } | pikr -d -p "Bluetooth · new devices$scan_legend" "${scanning[@]}" "${scan_keys[@]}")
        else
            pick_from scan "Bluetooth · new devices$scan_legend" "${scan_keys[@]}"
        fi
        ;;
    forget) pick_from forget "Bluetooth · forget" ;;
    actions) pick_from actions "Bluetooth · actions" ;;
    off) pick_from off "Bluetooth · off" ;;
    *) pick_from known "$known_prompt" "${known_keys[@]}" ;;
    esac
    picked=$?
    fi

    # Keys that act on the adapter rather than on the highlighted row.
    if [[ $mode == known && $picked == "$key_scan" ]] || [[ $mode == scan && $picked == "$key_rescan" ]]; then
        relock || exit
        mode=scan
        continue
    fi
    if [[ $mode == known && $picked == "$key_power" ]]; then
        # pikr's card already asked, so act immediately.
        relock || exit
        do_power off && notify "Bluetooth off"
        exit
    fi

    # Cancelled (Esc exits 1, the toggle's SIGTERM 143), nothing chosen, or
    # several rows (Visual mode).
    forgetting=false
    [[ $mode == known && $picked == "$key_forget" ]] && forgetting=true
    if [[ -z $pick || $pick == *$'\n'* ]] || { [[ $picked != 0 ]] && ! $forgetting; }; then
        exit
    fi
    relock || exit

    # Only a row from the list counts: pikr returns typed text that matches no
    # row (trimmed). A row shown more than once can't be told apart.
    matches=$(grep -cxF -- "$pick" "$rows")
    if ((matches != 1)); then
        ((matches > 1)) && notify "Two devices look identical in the list; not choosing either"
        exit
    fi
    line=$(grep -nxF -- "$pick" "$rows" | cut -d : -f1)
    IFS=$'\x1f' read -r action path alias < <(sed -n "${line}p" "$ids")

    if $forgetting; then
        # pikr's card already asked "Forget?", so act immediately.
        if [[ $action == @* ]]; then
            notify "Forget works on a paired device"
        else
            do_forget "$path" "$alias"
        fi
        exit
    fi

    case $action in
    @scan) mode=scan ;;
    @forget) mode=forget ;;
    @actions) mode=actions ;;
    @power-on)
        do_power on || exit
        mode=known
        ;;
    @power-off)
        do_power off && notify "Bluetooth off"
        exit
        ;;
    connect)
        pending=(do_connect "$path" "$alias")
        busy_text="Connecting to $alias…"
        ;;
    disconnect)
        pending=(do_disconnect "$path" "$alias")
        busy_text="Disconnecting $alias…"
        ;;
    pair)
        pending=(do_pair "$path" "$alias")
        busy_text="Pairing with $alias…"
        ;;
    forget) do_forget "$path" "$alias"; exit ;;
    blocked)
        notify "$alias is blocked; unblock it in bluetui"
        exit
        ;;
    *) exit ;;
    esac
done
